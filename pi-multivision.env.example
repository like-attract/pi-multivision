# pi-multivision 配置模板（复制为 ~/.pi/agent/pi-multivision.env 并填入你的 key）
# 每 1 组 VISION_MODEL_N_* 定义一个视觉模型，序号即失败切换顺序（最多 10 个）
# 前面的模型超时/限流/报错/空响应时，自动尝试下一个

# ---- 模型 1：GLM（智谱，GLM-4.6V-Flash 免费档）----
VISION_MODEL_1_NAME=glm
VISION_MODEL_1_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL_1_MODEL=glm-4.6v-flash
VISION_MODEL_1_KEY=YOUR_GLM_API_KEY

# ---- 模型 2（可选）：Step（ModelScope 网关）----
# VISION_MODEL_2_NAME=step
# VISION_MODEL_2_URL=https://api-inference.modelscope.cn/v1
# VISION_MODEL_2_MODEL=stepfun-ai/Step-3.7-Flash
# VISION_MODEL_2_KEY=YOUR_MODELSCOPE_API_KEY

# ---- 模型 3（可选）：Qwen（USTC-LLM 网关）----
# VISION_MODEL_3_NAME=qwen
# VISION_MODEL_3_URL=https://api.llm.ustc.edu.cn/v1
# VISION_MODEL_3_MODEL=qwen-chat
# VISION_MODEL_3_KEY=YOUR_USTC_API_KEY

# ---- 可选：单次请求超时秒数（默认 240）----
# VISION_TIMEOUT=240