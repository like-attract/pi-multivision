  "type": "module",
  "author": "like_attract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/like-attract/pi-multivision.git"
  },
  "homepage": "https://github.com/like-attract/pi-multivision#readme",
  "bugs": {
    "url": "https://github.com/like-attract/pi-multivision/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "vision",
    "image",
    "multimodal",
    "deepseek",
    "qwen",
    "glm",
    "step"
  ],
  "files": [
    "multivision.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./multivision.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  }
}
